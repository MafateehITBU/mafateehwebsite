NODE_ENV=development
PORT=4000
# The app resolves DATABASE_URL from POSTGRES_* when POSTGRES_PASSWORD is set (see src/config/env.ts).
# Prisma CLI also needs DATABASE_URL in the environment: use `npm run db:migrate`, `db:deploy`, or `db:generate`
# in this package — they run through `scripts/run-prisma.ts`, which loads the same resolver.

# Option A — full URL (works with plain `npx prisma` too):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mafateeh?schema=public"

# Option B — recommended with pgAdmin (password with special chars is fine; no URL encoding):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Sara@2002
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mafateeh

# Fallback if POSTGRES_PASSWORD is empty (set a real URL for Prisma if you use plain `npx prisma`):
DATABASE_URL=postgresql://postgres:Sara@2002@localhost:5432/mafateeh?schema=public
JWT_SECRET="replace-with-at-least-32-characters-long-secret-key"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: comma-separated admin emails for extra lockdown (leave empty to allow any active admin)
# ADMIN_EMAIL_ALLOWLIST=
