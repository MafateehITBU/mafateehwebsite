NODE_ENV=production
PORT=4000

# Internal Docker DNS host points to postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=mafateeh

# Must be at least 32 characters.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_PLUS
JWT_EXPIRES_IN=8h

# Allow website + dashboard domains
CORS_ORIGIN=https://mafateehgroup.com,https://www.mafateehgroup.com,https://dashboard.mafateehgroup.com,https://www.dashboard.mafateehgroup.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mafateeh Contact <noreply@mafateeh.com>
CONTACT_NOTIFY_TO=sarasuleiman1234@gmail.com,mohammed.f.zain@gmail.com,khaledalquzai@gmail.com,mp@mafateehgroup.com
